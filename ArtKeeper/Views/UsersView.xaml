<UserControl x:Class="ArtKeeper.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Управление сотрудниками" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Зарегистрировать" Command="{Binding ToggleAddingPanelCommand}" Style="{StaticResource ActionBtn}" Background="#2E7D32" Margin="0,0,10,0"/>
                <Button Content="🔄 Обновить" Command="{Binding LoadDataCommand}" Style="{StaticResource ActionBtn}"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding UsersList}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО Сотрудника" Binding="{Binding FullName}" Width="250"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.RoleName}" Width="180"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddingPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="ФИО:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Логин:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="Пароль:" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="txtNewPassword" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,10">
                        <TextBlock Text="Роль:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewRole}" DisplayMemberPath="RoleName" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Email:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Command="{Binding ToggleAddingPanelCommand}" Style="{StaticResource ActionBtn}" Background="#888888" Margin="0,0,10,0"/>
                    <Button Content="Создать аккаунт" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=txtNewPassword}" Style="{StaticResource ActionBtn}" Background="#2E7D32"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>