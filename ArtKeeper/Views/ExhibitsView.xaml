<UserControl x:Class="ArtKeeper.Views.ExhibitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Картотека экспонатов" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333333"/>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Content="➕ Добавить экспонат" Command="{Binding AddCommand}" Style="{StaticResource ActionBtn}" Margin="0,0,10,0" Background="#2E7D32"/>
            <Button Content="🗑 Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource ActionBtn}" Margin="0,0,10,0" Background="#C62828"/>
            <Button Content="🔄 Обновить базу" Command="{Binding LoadDataCommand}" Style="{StaticResource ActionBtn}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Exhibits}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding CurrentStatus}"/>
                <DataGridTextColumn Header="Зал" Binding="{Binding Hall.HallName}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>