<UserControl x:Class="ArtKeeper.Views.ExhibitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Картотека экспонатов" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Зарегистрировать" Command="{Binding ToggleAddingPanelCommand}" Style="{StaticResource ActionBtn}" Background="#2E7D32" Margin="0,0,10,0"/>
                <Button Content="🗑 Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource ActionBtn}" Background="#C62828" Margin="0,0,10,0"/>
                <Button Content="🔄 Обновить базу" Command="{Binding LoadDataCommand}" Style="{StaticResource ActionBtn}"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Exhibits}" SelectedItem="{Binding SelectedExhibit}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Инв. №" Binding="{Binding InventoryNumber}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}"/>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialTechnique}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding CurrentStatus}"/>
                <DataGridTextColumn Header="Зал/Хранилище" Binding="{Binding Hall.HallName}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddingPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="Инв. номер:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewInvNumber, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Название:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="Материал/Техника:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewMaterial, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,0,10">
                        <TextBlock Text="Место хранения:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableHalls}" SelectedItem="{Binding NewHall}" DisplayMemberPath="HallName" Padding="5"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Command="{Binding ToggleAddingPanelCommand}" Style="{StaticResource ActionBtn}" Background="#888888" Margin="0,0,10,0"/>
                    <Button Content="Сохранить в БД" Command="{Binding SaveCommand}" Style="{StaticResource ActionBtn}" Background="#2E7D32"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>