<UserControl x:Class="ArtKeeper.Views.ExhibitionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выставочные проекты" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333333"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ExhibitionsList}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название выставки" Binding="{Binding Title}" Width="250"/>
                <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Куратор" Binding="{Binding Curator.FullName}" Width="180"/>
                <DataGridTextColumn Header="Бюджет (руб.)" Binding="{Binding TotalBudget, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>