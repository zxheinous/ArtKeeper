<UserControl x:Class="ArtKeeper.Views.ExhibitionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Выставочные проекты" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Новая выставка" Command="{Binding ToggleAddingPanelCommand}" Style="{StaticResource ActionBtn}" Background="#2E7D32" Margin="0,0,10,0"/>
                <Button Content="🔄 Обновить" Command="{Binding LoadDataCommand}" Style="{StaticResource ActionBtn}"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ExhibitionsList}" SelectedItem="{Binding SelectedExhibition}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название выставки" Binding="{Binding Title}" Width="250"/>
                <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Куратор" Binding="{Binding Curator.FullName}" Width="180"/>
                <DataGridTextColumn Header="Бюджет (руб.)" Binding="{Binding TotalBudget, StringFormat={}{0:N2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddingPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="Название:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Куратор:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableCurators}" SelectedItem="{Binding NewCurator}" DisplayMemberPath="FullName" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="Начало:" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding NewStartDate}" Padding="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,10">
                        <TextBlock Text="Окончание:" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding NewEndDate}" Padding="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Бюджет:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewBudget, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Command="{Binding ToggleAddingPanelCommand}" Style="{StaticResource ActionBtn}" Background="#888888" Margin="0,0,10,0"/>
                    <Button Content="Утвердить проект" Command="{Binding SaveCommand}" Style="{StaticResource ActionBtn}" Background="#2E7D32"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>