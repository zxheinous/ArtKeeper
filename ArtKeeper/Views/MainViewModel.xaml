<Window x:Class="ArtKeeper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArtKeeper.Views"
        xmlns:vms="clr-namespace:ArtKeeper.ViewModels"
        Title="АртХранитель" Height="600" Width="900" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vms:ExhibitsViewModel}">
            <views:ExhibitsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2D2D30">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="White" Margin="0,0,0,20"/>

                <Button Content="Картотека экспонатов" Command="{Binding NavigateExhibitsCommand}" Margin="0,5"/>
                <Button Content="Выход" Command="{Binding LogoutCommand}" Margin="0,50,0,0" Background="DarkRed" Foreground="White"/>
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Grid.Column="1" Margin="10"/>
    </Grid>
</Window>